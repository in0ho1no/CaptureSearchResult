{
  "name": "capture-search-result",
  "displayName": "Capture Search Result",
  "description": "This extension captures VSCode search result.",
  "version": "0.1.2",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "publisher": "in0ho1no",
  "icon": "images/CaptureSearchResult.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/in0ho1no/CaptureSearchResult"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "capture-search-result.copySearchResults",
        "title": "Copy Search Results"
      }
    ],
    "keybindings": [
      {
        "command": "capture-search-result.copySearchResults",
        "key": "ctrl+alt+c",
        "when": "inSearchEditor"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Capture Search Result Configuration",
      "properties": {
        "capture-search-result.separator": {
          "type": "string",
          "default": "♪",
          "description": "Separator character used for processing search results"
        },
        "capture-search-result.copy-summary": {
          "type": "boolean",
          "default": true,
          "description": "Include search summary when copying search results. True: include / False: do not include"
        },
        "capture-search-result.add-columnTitleRow": {
          "type": "boolean",
          "default": true,
          "description": "Include column title row when copying search results. True: include / False: do not include"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "compile": "webpack",
    "watch": "webpack --watch",
    "build:prod": "webpack --mode production --devtool hidden-source-map",
    "vsix": "vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "26.x",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.7.0",
    "eslint-plugin-redos": "^4.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "overrides": {
    "serialize-javascript": "~7.0.3",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "glob": "^13.0.6"
  }
}
